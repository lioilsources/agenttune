{
  "$schema": "https://opencode.ai/config.json",
  "autoupdate": false,
  "share": "disabled",
  "provider": {
    "llm": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "LLM endpoint (OpenAI-compatible)",
      "options": {
        "baseURL": "{env:AGENTTUNE_LLM_BASE_URL}",
        "apiKey": "{env:AGENTTUNE_LLM_API_KEY}"
      },
      "models": {
        "bench-qwen36": {
          "name": "Qwen3.6 35B A3B (bench, no thinking)",
          "tool_call": true
        },
        "bench-qwen36-think": {
          "name": "Qwen3.6 35B A3B (bench, thinking)",
          "tool_call": true
        },
        "qwen3-coder": {
          "name": "Qwen3-Coder 30B A3B FP8",
          "tool_call": true
        }
      }
    }
  },
  "permission": {
    "edit": "allow",
    "bash": "allow",
    "webfetch": "deny",
    "external_directory": "deny"
  }
}
