# Copy to .env and fill in. .env is not committed.
# SPARK gateway: http://SPARK_HOST:8080/v1 (model bench-qwen36)
# L40S vLLM via ssh tunnel: http://127.0.0.1:8003/v1 (model qwen3-coder)
AGENTTUNE_LLM_BASE_URL=http://127.0.0.1:8003/v1
AGENTTUNE_LLM_API_KEY=dummy
# eval_window.sh: GPU window owned by another host queue
WINDOW_SSH=gpu-host
WINDOW_READY=/path/on/host/AGENTTUNE_READY
WINDOW_DONE=/path/on/host/AGENTTUNE_DONE
WINDOW_PORT=8003
WINDOW_MIN=170
EVAL_MODEL=qwen3-coder
